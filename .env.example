# ==============================================================================
# CodePulse Environment Variables Template
# Copy this file to .env and provide your actual credentials.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# Server Runtime Configuration
NODE_ENV=production
PORT=5000

# Database Configuration (SQLite / Turso / D1)
DATABASE_PATH=./data/codetrack.sqlite
DATABASE_URL=file:./data/codetrack.sqlite

# Security & Authentication (Generate secure random string for JWT_SECRET in production)
JWT_SECRET=your_super_secret_jwt_random_key_min_32_chars
SESSION_SECRET=your_super_secret_session_key

# Cross-Origin Resource Sharing (CORS)
FRONTEND_URL=https://codepulse.yourdomain.com
BACKEND_URL=https://api.yourdomain.com
CORS_ORIGIN=https://codepulse.yourdomain.com

# GitHub Integration (Optional OAuth)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_USERNAME=

# Cloudflare Deployment Configuration
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_PAGES_PROJECT=codepulse

# Frontend Environment Variables (Passed to Vite build)
VITE_API_URL=https://api.yourdomain.com/api
